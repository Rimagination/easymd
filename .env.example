# Public app URL after deployment
VITE_APP_URL=https://your-domain.example

# ANALYTICS_SCRIPT_URL=https://button.click/api/script.js
# ANALYTICS_SITE_ID=a2f02dd2e67d

# Local uploads (store images on local disk)
# LOCAL_UPLOAD_DIR=./.local-uploads
# LOCAL_UPLOAD_PUBLIC_PATH=/uploads

S3_ENDPOINT=https://s3.us-west-001.backblazeb2.com
S3_BUCKET=some-temp-files
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_REGION=auto
S3_PUBLIC_BASE_URL=https://cdn.your-domain.example

# WeChat Open Platform third-party authorization (server-only)
# The component credentials belong to easymd. Users authorize their own
# Official Accounts through the web UI and never enter these values.
# WECHAT_COMPONENT_APPID=your-third-party-platform-appid
# WECHAT_COMPONENT_APPSECRET=your-third-party-platform-appsecret
# WECHAT_COMPONENT_TOKEN=your-third-party-platform-message-token
# WECHAT_COMPONENT_ENCODING_AES_KEY=your-third-party-platform-encoding-aes-key
# EASYMD_WECHAT_DATA_KEY=generate-a-random-secret-at-least-32-characters
# Comma-separated hosts allowed for server-side article image fetching.
# WECHAT_IMAGE_HOSTS=cdn.your-domain.example
